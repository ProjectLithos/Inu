<Project>
  <!-- Generated default configuration. Apply Configuration Pages to regenerate. -->
  <PropertyGroup>
    <InuSdkRoot Condition="'$(InuSdkRoot)' == '' And '$(INU_SDK_ROOT)' != ''">$(INU_SDK_ROOT)</InuSdkRoot>
    <InuSdkRoot Condition="'$(InuSdkRoot)' == ''">C:\Inu</InuSdkRoot>
    <InuConfigurationVersion>3</InuConfigurationVersion>
    <InuTargetArchitecture>x64</InuTargetArchitecture>
    <InuKernelModel>Monolithic</InuKernelModel>
    <InuBootProtocol>Uefi</InuBootProtocol>
    <InuConfigurationCompleted>false</InuConfigurationCompleted>
    <InuWorkAreas>Shell;GUI;Drivers;HAL;Audio;Filesystems;Storage;Networking;USB;Input;Processes;Scheduler;System Calls;Security;Diagnostics;Tests</InuWorkAreas>
    <InuDevelopmentAreas></InuDevelopmentAreas>
    <InuDefaultExecutionDomain>Kernel</InuDefaultExecutionDomain>
    <InuKernelAreaShell>false</InuKernelAreaShell>
    <InuKernelAreaGUI>false</InuKernelAreaGUI>
    <InuKernelAreaDrivers>true</InuKernelAreaDrivers>
    <InuKernelAreaHAL>true</InuKernelAreaHAL>
    <InuKernelAreaAudio>false</InuKernelAreaAudio>
    <InuKernelAreaFilesystems>true</InuKernelAreaFilesystems>
    <InuKernelAreaStorage>true</InuKernelAreaStorage>
    <InuKernelAreaNetworking>true</InuKernelAreaNetworking>
    <InuKernelAreaUSB>true</InuKernelAreaUSB>
    <InuKernelAreaInput>true</InuKernelAreaInput>
    <InuKernelAreaProcesses>true</InuKernelAreaProcesses>
    <InuKernelAreaScheduler>true</InuKernelAreaScheduler>
    <InuKernelAreaSystemCalls>true</InuKernelAreaSystemCalls>
    <InuKernelAreaSecurity>true</InuKernelAreaSecurity>
    <InuKernelAreaDiagnostics>true</InuKernelAreaDiagnostics>
    <InuKernelAreaTests>false</InuKernelAreaTests>
    <DefineConstants>$(DefineConstants);INU_ARCH_X64;INU_KERNEL_MONOLITHIC;INU_WORKAREA_HAL;INU_WORKAREA_DRIVERS;INU_WORKAREA_STORAGE;INU_WORKAREA_FILESYSTEMS;INU_WORKAREA_NETWORKING;INU_WORKAREA_USB;INU_WORKAREA_INPUT;INU_WORKAREA_PROCESSES;INU_WORKAREA_SCHEDULER;INU_WORKAREA_SYSTEM_CALLS;INU_WORKAREA_SECURITY;INU_WORKAREA_DIAGNOSTICS;INU_KERNELAREA_HAL;INU_KERNELAREA_DRIVERS;INU_KERNELAREA_STORAGE;INU_KERNELAREA_FILESYSTEMS;INU_KERNELAREA_NETWORKING;INU_KERNELAREA_USB;INU_KERNELAREA_INPUT;INU_KERNELAREA_PROCESSES;INU_KERNELAREA_SCHEDULER;INU_KERNELAREA_SYSTEM_CALLS;INU_KERNELAREA_SECURITY;INU_KERNELAREA_DIAGNOSTICS;INU_COMPONENT_NETWORK_ROUTE_MANAGER;INU_COMPONENT_NETWORK_NEIGHBOR_CACHE;INU_COMPONENT_NETWORK_SOCKET_SERVICE;INU_COMPONENT_NETWORK_DHCP_CODEC;INU_COMPONENT_NETWORK_DNS_CODEC;INU_COMPONENT_NETWORK_ARP_PROTOCOL;INU_COMPONENT_NETWORK_IPV4_PROTOCOL;INU_COMPONENT_NETWORK_ICMPV4_PROTOCOL;INU_COMPONENT_NETWORK_UDP_IPV4_PROTOCOL;INU_COMPONENT_NETWORK_TCP_OBSERVATION_PROTOCOL;INU_COMPONENT_NETWORK_IPV6_NDP_PROTOCOL;INU_COMPONENT_NETWORK_E1000_DRIVER;INU_COMPONENT_NETWORK_RTL8168_DRIVER;INU_COMPONENT_USB_ENUMERATION;INU_COMPONENT_STORAGE_PARTITION_DISCOVERY;INU_COMPONENT_STORAGE_NVME_DRIVER;INU_COMPONENT_STORAGE_AHCI_DRIVER;INU_COMPONENT_INPUT_KEYBOARD_DECODER;INU_COMPONENT_USB_HID_KEYBOARD;INU_COMPONENT_USB_HID_MOUSE;INU_COMPONENT_USB_MASS_STORAGE;INU_COMPONENT_GRAPHICS_FIRMWARE_FRAMEBUFFER;INU_COMPONENT_TIME_HPET_CLOCK_SOURCE;INU_COMPONENT_TIME_INVARIANT_TSC_CLOCK_SOURCE;INU_COMPONENT_TIME_RTC_CMOS_WALL_CLOCK;INU_COMPONENT_TIME_LOCAL_APIC_INTERRUPT_TIMER;INU_COMPONENT_INTERRUPTS_AFFINITY_RESOLVER;INU_COMPONENT_INTERRUPTS_IO_APIC_ROUTER;INU_COMPONENT_INTERRUPTS_PCI_MESSAGE_ROUTER;INU_COMPONENT_PCI_LEGACY_CONFIGURATION;INU_COMPONENT_PCI_ECAM_CONFIGURATION;INU_COMPONENT_ACPI_MCFG;INU_COMPONENT_ACPI_MADT;INU_COMPONENT_ACPI_HPET_TABLE;INU_COMPONENT_ACPI_FADT;INU_COMPONENT_ACPI_POWER;INU_COMPONENT_ACPI_EMBEDDED_CONTROLLER;INU_COMPONENT_PROCESS_LIFECYCLE;INU_COMPONENT_PROCESS_ADDRESS_SPACE_OWNERSHIP;INU_COMPONENT_PROCESS_FOREGROUND_CONTROL;INU_COMPONENT_PROCESS_SIGNALS</DefineConstants>
  </PropertyGroup>
</Project>
