{
  "schemaVersion": 2,
  "apiVersion": "1.0",
  "kind": "user-command-api",
  "authority": "Inu/src/Common/Inu.Cli/Program.cs",
  "rule": "Only commands accepted by the canonical inu executable are part of the user-facing SDK command API.",
  "commands": [
    {
      "name": "build",
      "syntax": "inu build [--root <path>] [--force-rebuild]",
      "description": "Build Inu and Kath from the selected Kath&Inu root.",
      "options": [
        "--root <path>",
        "--force-rebuild"
      ]
    },
    {
      "name": "toolchain ensure",
      "syntax": "inu toolchain ensure [--root <path>]",
      "description": "Verify that the private Inu toolchain required by the current build is present.",
      "options": [
        "--root <path>"
      ]
    },
    {
      "name": "version",
      "syntax": "inu version",
      "aliases": [
        "inu --version",
        "inu -v"
      ],
      "description": "Print the Inu executable version.",
      "options": []
    },
    {
      "name": "help",
      "syntax": "inu help",
      "aliases": [
        "inu --help",
        "inu -h"
      ],
      "description": "Print the authoritative command list.",
      "options": []
    }
  ],
  "codingApi": {
    "status": "explicit-only",
    "exportMarker": "<inu.api>",
    "description": "C# declarations are not SDK API merely because they are public. Only declarations explicitly marked for SDK users are published.",
    "exports": [
      {
        "namespace": "System",
        "type": "Console",
        "members": [
          "Write(string)",
          "Write(char)",
          "Write(bool)",
          "Write(int)",
          "Write(uint)",
          "Write(long)",
          "Write(ulong)",
          "WriteLine()",
          "WriteLine(string)",
          "WriteLine(char)",
          "WriteLine(bool)",
          "WriteLine(int)",
          "WriteLine(uint)",
          "WriteLine(long)",
          "WriteLine(ulong)",
          "Clear()"
        ],
        "availability": "ring-3 userland",
        "transport": "Event syscall",
        "notes": "Freestanding .NET-compatible console supplied by Inu; preferred for new userland source."
      },
      {
        "namespace": "Inu.Userland.Runtime",
        "type": "Output",
        "members": [
          "Write(string)",
          "WriteLine(string)",
          "Clear()"
        ],
        "availability": "ring-3 userland",
        "transport": "Event syscall",
        "notes": "Compatibility surface retained for source written against Inu 0.0.58."
      },
      {
        "namespace": "System.Collections",
        "type": "Collection contracts",
        "members": [
          "IEnumerable",
          "IEnumerator",
          "ICollection"
        ],
        "availability": "freestanding managed code (kernel and ring-3 userland)",
        "transport": "in-process CoreLib",
        "notes": "Inu-owned .NET-compatible non-generic collection contracts used by foreach and collection implementations."
      },
      {
        "namespace": "System.Collections.Generic",
        "type": "Generic collections",
        "members": [
          "IEnumerable<T>",
          "IEnumerator<T>",
          "ICollection<T>",
          "IList<T>",
          "IReadOnlyCollection<T>",
          "IReadOnlyList<T>",
          "KeyValuePair<TKey,TValue>",
          "EqualityComparer<T>",
          "List<T>",
          "Dictionary<TKey,TValue>",
          "Queue<T>",
          "Stack<T>"
        ],
        "availability": "freestanding managed code (kernel and ring-3 userland)",
        "transport": "in-process CoreLib",
        "notes": "Inu-owned .NET-compatible generic collections. No desktop .NET runtime dependency."
      },
      {
        "namespace": "System.Text",
        "type": "Text construction and encoding",
        "members": [
          "StringBuilder",
          "StringBuilder.Append(string)",
          "StringBuilder.Append(char)",
          "StringBuilder.Append(bool)",
          "StringBuilder.Append(int/uint/long/ulong)",
          "StringBuilder.AppendLine()",
          "StringBuilder.AppendLine(string)",
          "StringBuilder.Clear()",
          "StringBuilder.ToString()",
          "Encoding.ASCII",
          "Encoding.UTF8",
          "Encoding.GetByteCount(string)",
          "Encoding.GetBytes(string)",
          "Encoding.GetString(byte[])",
          "ASCIIEncoding",
          "UTF8Encoding"
        ],
        "availability": "freestanding managed code (kernel and ring-3 userland)",
        "transport": "in-process CoreLib",
        "notes": "Inu-owned .NET-compatible StringBuilder plus initial ASCII and UTF-8 encoding support. No desktop .NET runtime dependency."
      }
    ]
  }
}
