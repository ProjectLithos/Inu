<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Inu.DotNetConformance.Tests</AssemblyName>
    <RootNamespace>Inu.DotNetConformance.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared conformance sources are release companions: ChangedFiles must carry every referenced file. -->
    <Compile Include="..\..\src\Inu.Runtime.Conformance\Shared\ArrayEnumerationConformance.cs" Link="Shared\ArrayEnumerationConformance.cs" />
    <Compile Include="..\..\src\Inu.Runtime.Conformance\Shared\ListConformance.cs" Link="Shared\ListConformance.cs" />
    <Compile Include="..\..\src\Inu.Runtime.Conformance\Shared\CoreCollectionsConformance.cs" Link="Shared\CoreCollectionsConformance.cs" />
    <Compile Include="..\..\src\Inu.Runtime.Conformance\Shared\TupleConformance.cs" Link="Shared\TupleConformance.cs" />
    <Compile Include="..\..\src\Inu.Runtime.Conformance\Shared\LinqConformance.cs" Link="Shared\LinqConformance.cs" />
  </ItemGroup>
</Project>
