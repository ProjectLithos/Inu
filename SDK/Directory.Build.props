<Project>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Version>0.0.92</Version>
    <AssemblyVersion>0.0.92.0</AssemblyVersion>
    <FileVersion>0.0.92.0</FileVersion>
    <PackageVersion>0.0.92</PackageVersion>
    <Authors>ProjectLithos</Authors>
    <Company>ProjectLithos</Company>
    <Product>Inu OS SDK</Product>
    <RepositoryUrl>https://github.com/ProjectLithos/Inu.git</RepositoryUrl>
  </PropertyGroup>
</Project>
