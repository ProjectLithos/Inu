      "thread.runnable-set",
      "scheduler.cpu-runnable-sets",
      "time.monotonic"
    ]
  },
  "dependencies": [
    "Kernel.Scheduler.PlacementRegistry",
    "Kernel.Scheduler.CpuRunQueues",
    "Kernel.Scheduler.PolicyRegistry",
    "Kernel.Time.ClockCore"
  ],
  "implementations": {
    "CSharp": {
      "status": "available",
      "project": "src/Inu.Kernel.Scheduler/Inu.Kernel.Scheduler.csproj",
      "sources": [
        "src/Inu.Kernel.Scheduler/KernelScheduler.LoadAwarePlacementPolicy.cs"
      ]
    }
  }
}
