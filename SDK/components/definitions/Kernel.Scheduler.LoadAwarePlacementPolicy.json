{
  "$schema": "Inu.ComponentDefinition.schema.json",
  "schemaVersion": 1,
  "id": "Kernel.Scheduler.LoadAwarePlacementPolicy",
  "displayName": "Load-aware CPU placement policy",
  "area": "Kernel",
  "selection": {
    "status": "selectable",
