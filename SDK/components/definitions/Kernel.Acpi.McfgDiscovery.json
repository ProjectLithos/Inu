{
  "$schema": "Inu.ComponentDefinition.schema.json",
  "schemaVersion": 1,
  "id": "Kernel.Acpi.McfgDiscovery",
  "displayName": "ACPI MCFG discovery provider",
  "area": "Kernel",
  "selection": {
    "status": "selectable",
    "reason": "Owns MCFG ECAM-allocation parsing and registers only through KernelAcpiMcfgServices; PCI can retain legacy configuration support when this component is omitted."
