    "startup": "boot"
  },
  "contracts": {
    "provides": [
      "acpi.mcfg"
    ],
    "requires": [
      "acpi.table-registry"
    ]
  },
  "dependencies": [
    "Kernel.Acpi.TableRegistry"
  ],
  "implementations": {
    "CSharp": {
      "status": "available",
      "project": "src/Inu.Kernel.Acpi/Inu.Kernel.Acpi.csproj",
      "sources": [
        "src/Inu.Kernel.Acpi/KernelAcpiMcfgProvider.cs",
        "src/Inu.Kernel.Acpi/KernelAcpiMcfgServices.cs",
        "src/Inu.Kernel.Acpi/KernelAcpi.PlatformTables.cs"
      ]
    }
  }
}
