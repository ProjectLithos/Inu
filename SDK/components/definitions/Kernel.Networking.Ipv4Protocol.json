{
  "$schema": "Inu.ComponentDefinition.schema.json",
  "schemaVersion": 1,
  "id": "Kernel.Networking.Ipv4Protocol",
  "displayName": "IPv4 packet protocol",
  "area": "Kernel",
  "selection": {
    "status": "selectable",
    "reason": "IPv4 header validation, routing-facing packet construction and Ethernet transmission are isolated from ICMPv4, UDP and TCP handling; the parent Ethernet/networking core names only the IPv4 packet contract."
  },
  "lifecycle": {
    "ownership": "kernel",
    "startup": "boot"
  },
  "contracts": {
    "provides": [
      "network.ipv4",
      "network.ipv4-send"
    ],
    "requires": [
      "network.packet-registry",
      "network.ipv4-transport-registry",
      "network.interface-registry",
      "network.route-management",
      "network.neighbor-cache"
    ]
  },
  "dependencies": [
    "Kernel.Networking.PacketRegistry",
    "Kernel.Networking.Ipv4TransportRegistry",
    "Kernel.Networking.InterfaceRegistry",
    "Kernel.Networking.RouteManager",
    "Kernel.Networking.NeighborCache"
  ],
  "implementations": {
    "CSharp": {
      "status": "available",
      "project": "src/Inu.Kernel.Networking/Inu.Kernel.Networking.csproj",
      "sources": [
        "src/Inu.Kernel.Networking/KernelIpv4Services.cs",
        "src/Inu.Kernel.Networking/KernelIpv4Protocol.cs"
      ]
    }
  }
}
