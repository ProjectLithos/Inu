    "ownership": "kernel",
    "startup": "boot"
  },
  "contracts": {
    "provides": [
      "acpi.table-registry"
    ],
    "requires": [
      "boot.acpi-root-pointer"
    ]
  },
  "dependencies": [],
  "implementations": {
    "CSharp": {
      "status": "available",
      "project": "src/Inu.Kernel.Acpi/Inu.Kernel.Acpi.csproj",
      "sources": [
        "src/Inu.Kernel.Acpi/KernelAcpi.cs",
        "src/Inu.Kernel.Acpi/KernelAcpi.Discovery.cs",
        "src/Inu.Kernel.Acpi/KernelAcpi.Validation.cs"
      ]
    }
  }
}
