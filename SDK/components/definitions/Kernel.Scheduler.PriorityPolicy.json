      "scheduler.thread-placement"
    ]
  },
  "dependencies": [
    "Kernel.Scheduler.PolicyRegistry",
    "Kernel.Scheduler.PlacementRegistry"
  ],
  "implementations": {
    "CSharp": {
      "status": "available",
      "project": "src/Inu.Kernel.Scheduler/Inu.Kernel.Scheduler.csproj",
      "sources": [
        "src/Inu.Kernel.Scheduler/KernelScheduler.PriorityPolicy.cs"
      ]
    }
  }
}
