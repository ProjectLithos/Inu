{
  "$schema": "Inu.ComponentDefinition.schema.json",
  "schemaVersion": 1,
  "id": "Kernel.Pci.LegacyConfiguration",
  "displayName": "PCI legacy configuration I/O transport",
  "area": "Kernel",
  "selection": {
    "status": "selectable",
    "reason": "Owns x86 PCI configuration mechanism #1 CF8/CFC port access and registers only through the PCI configuration registry; the PCI core remains valid when this transport is omitted."
