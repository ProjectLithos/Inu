  "lifecycle": {
    "ownership": "kernel",
    "startup": "boot"
  },
  "contracts": {
    "provides": [
      "pci.configuration.legacy-io"
    ],
    "requires": [
      "pci.configuration-registry",
      "architecture.x64.io-port"
    ]
  },
  "dependencies": [
    "Kernel.Pci.ConfigurationRegistry"
  ],
  "implementations": {
    "CSharp": {
      "status": "available",
      "project": "src/Inu.Kernel.Pci/Inu.Kernel.Pci.csproj",
      "sources": [
        "src/Inu.Kernel.Pci/KernelPciLegacyConfigurationProvider.cs"
      ]
    }
  }
}
