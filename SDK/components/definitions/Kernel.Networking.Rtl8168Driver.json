      "sources": [
        "src/Inu.Kernel.Rtl8168/KernelRtl8168.DriverLifecycle.cs",
        "src/Inu.Kernel.Rtl8168/KernelRtl8168.Hardware.cs",
        "src/Inu.Kernel.Rtl8168/KernelRtl8168.NetworkIo.cs",
        "src/Inu.Kernel.Rtl8168/KernelRtl8168.StorageAndMmio.cs",
        "src/Inu.Kernel.Rtl8168/KernelRtl8168.cs",
        "src/Inu.Kernel.Rtl8168/Rtl8168Contracts.cs",
        "src/Inu.Kernel.Rtl8168/Rtl8168Math.cs"
      ]
    }
