{
  "$schema": "Inu.ComponentDefinition.schema.json",
  "schemaVersion": 1,
  "id": "Kernel.Pci.EcamConfiguration",
  "displayName": "PCI Express ECAM configuration transport",
  "area": "Kernel",
  "selection": {
    "status": "selectable",
    "reason": "Owns ACPI MCFG lookup, ECAM function mapping and transient configuration-window state and registers only through the PCI configuration registry; the PCI core remains valid when this transport is omitted."
