  "lifecycle": {
    "ownership": "kernel",
    "startup": "boot"
  },
  "contracts": {
    "provides": [
      "pci.configuration.ecam"
    ],
    "requires": [
      "pci.configuration-registry",
      "acpi.mcfg",
      "memory.virtual.mmio"
    ]
  },
  "dependencies": [
    "Kernel.Pci.ConfigurationRegistry",
    "Kernel.Acpi.McfgDiscovery"
  ],
  "implementations": {
    "CSharp": {
      "status": "available",
      "project": "src/Inu.Kernel.Pci/Inu.Kernel.Pci.csproj",
      "sources": [
        "src/Inu.Kernel.Pci/KernelPciEcamConfigurationProvider.cs"
      ]
    }
  }
}
